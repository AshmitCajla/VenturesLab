# Automatic HTTPS for a single VM. DOMAIN can be a free sslip.io name such as 203-0-113-7.sslip.io
# (subdomains resolve too), or your own domain with A records for the apex and the subdomains below.
{
	email {$ACME_EMAIL}
}

# Streamlit UI
{$DOMAIN} {
	encode gzip
	reverse_proxy frontend:8501
}

# API, Slack bot status, and the MCP endpoint at /mcp
api.{$DOMAIN} {
	encode gzip
	@internal path /metrics /chaos*
	respond @internal 404
	reverse_proxy backend:8000 {
		flush_interval -1  # stream MCP responses (server-sent events) without buffering
	}
}

# Dashboards (Grafana has its own login in production)
grafana.{$DOMAIN} {
	reverse_proxy grafana:3000
}
