# Copy to backend/.env and fill in. NEVER commit the real .env file.
# At least one LLM provider key is required.
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=groq                 # which provider to try first
# REASONING_MODEL=openai/gpt-oss-120b   (Groq retired llama-3.3-70b-versatile on 2026-08-16)
# FAST_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free   # free models end in :free (50 requests/day on a free account)

# Optional: persistent vector store (defaults to in-memory)
QDRANT_URL=
QDRANT_API_KEY=

# Optional: persist results (defaults to ./data/results/*.json)
SUPABASE_URL=
SUPABASE_KEY=

# EMBEDDINGS=fastembed            # or "hash" for a zero-dependency fallback
# WEB_SEARCH=1
# BUILD_THRESHOLD=0.65
# MAX_CONCURRENT_JOBS=3
# CORS_ORIGINS=*
