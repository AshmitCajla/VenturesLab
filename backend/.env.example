# Copy to backend/.env and fill in. NEVER commit the real .env file.

# ---- Models (at least one key) ------------------------------------------------------
GROQ_API_KEY=
OPENROUTER_API_KEY=                 # fallback provider; also enables the free vision model
LLM_PROVIDER=groq                   # which provider to try first
# FAST_MODEL=openai/gpt-oss-20b
# REASONING_MODEL=openai/gpt-oss-120b
# OPENROUTER_FAST_MODEL=nvidia/nemotron-3-super-120b-a12b:free       (with credits: openai/gpt-oss-20b)
# OPENROUTER_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b:free  (with credits: openai/gpt-oss-120b)
# VISION_MODEL=openrouter:nvidia/nemotron-3.5-super-vl:free         (default when OPENROUTER_API_KEY is set; "off" disables)

# ---- Agent system ----------------------------------------------------------------------
# PLANNER=1                         # planner picks optional agents per deck
# RUN_BUDGET_USD=0.25               # optional agents are skipped before a run exceeds this
# INJECTION_DEFENSES=1              # 0 only to measure attack success without defences
# SEMANTIC_SCREEN=1                 # model-based screen for paraphrased injections
# WEB_SEARCH=1
# BUILD_THRESHOLD=0.65
# MAX_CONCURRENT_JOBS=3

# ---- Public deployment ------------------------------------------------------------------
# API_KEYS=                         # comma-separated; required when the API is reachable from the internet
# RATE_LIMIT_RUNS_PER_HOUR=20       # new analyses per key per hour (follow-up questions: 5x)
# PUBLIC_API_URL=https://api.example.com   # also allows this Host for the /mcp endpoint
# MCP_ALLOWED_HOSTS=                # extra Host headers allowed for /mcp
# PUBLIC_METRICS=0                  # 1 = /metrics without a key (the Docker stack sets it; Caddy blocks it publicly)

# ---- Storage ---------------------------------------------------------------------------
# DB_PATH=./data/ventureslab.db     # runs, feedback, cache, memory, incidents
# LOG_DIR=./data/logs               # JSON logs read by the ops agent
QDRANT_URL=                         # optional persistent vector store
QDRANT_API_KEY=
SUPABASE_URL=                       # optional copy of finished analyses
SUPABASE_KEY=

# ---- Slack (docs/slack-and-mcp.md) -----------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_OPS_CHANNEL=                  # channel id for incidents and ops questions
SLACK_DIGEST_CHANNEL=               # channel id for the weekly digest
# PUBLIC_UI_URL=http://localhost:8501

# ---- Observability ---------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# PROMETHEUS_URL=http://localhost:9090
# JAEGER_URL=http://localhost:16686
# ALERT_WEBHOOK_TOKEN=              # shared with Alertmanager (docker-compose passes it through)
# SLO_SUCCESS_TARGET=0.99
# SLO_COMPLETE_TARGET=0.95
# SLO_LATENCY_TARGET_S=450
# LOG_JSON=0

# ---- Chaos testing (never in production) -----------------------------------------------
# CHAOS=0
# CORS_ORIGINS=*
